  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">FloorcountAudioController: music, clave and cues from the pad</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.AudioTrackAsset musicSlow {"hint":"Practice loop at Slow tempo. Its length must be a whole number of 8-counts."}'
    - '// @input Asset.AudioTrackAsset musicMedium {"hint":"Practice loop at Medium tempo."}'
    - '// @input Asset.AudioTrackAsset musicFull {"hint":"Practice loop at Full tempo."}'
    - '// @input Asset.AudioTrackAsset claveClick {"hint":"Clave click played on counts 1 and 5."}'
    - '// @input Asset.AudioTrackAsset uiTap {"hint":"Short tap played when a button or footprint is pinched."}'
    - '// @input Asset.AudioTrackAsset stepMastered {"hint":"Cue played when a step is mastered."}'
    - '// @input SceneObject padSpeaker {"hint":"Object on the pad the music and clave play from."}'
    - '// @input SceneObject cardSpeaker {"hint":"Object the button taps play from (the step card)."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float[] tempoBpm = {140,170,190} {"hint":"Beats per minute of the Slow, Medium and Full loops. Must match the audio files."}'
    - '// @input float musicVolume = 0.7 {"hint":"Music volume.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float claveVolume = 0.6 {"hint":"Clave click volume (counts 1 and 5).", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float cueVolume = 0.6 {"hint":"Volume of button taps and the step-mastered cue.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input bool spatialFromPad = true {"hint":"Play the music and clave as spatial sound from the pad."}'
    - '// @ui {"widget":"group_end"}'
